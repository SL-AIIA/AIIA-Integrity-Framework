{
  "manifest_version": 3,
  "name": "AIIA Anchor - Junior Edition",
  "version": "1.0",
  "description": "Simple intent protection for AI chats",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}